# Copy this file to .env and fill in real values. Never commit .env.

# Web Push (VAPID)
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI push services may use to reach you, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# Expiry reminders run on a built-in hourly scheduler by default, so no
# external cron is needed. Set to false to schedule the job yourself.
INTERNAL_CRON=true

# Shared secret required in the "Authorization: Bearer <CRON_SECRET>" header
# for POST /api/cron/check-expiry. Without it that route answers 503 -- it is
# public (an external cron has no session cookie), so an unset secret must
# close it, not open it. The built-in scheduler runs regardless.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Comma-separated list of extra hosts/IPs allowed to hit the Next.js dev server
ALLOWED_DEV_ORIGINS=

# Better Auth
# Generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Allow new accounts to be created with e-mail and password. An instance
# belongs to one household, not to the internet: once everyone has an account,
# set this to "false" and restart -- signing in keeps working, signing up does
# not. Leave it "true" for the very first start, otherwise there is no account
# at all. SSO is unaffected.
ALLOW_REGISTRATION=true

# CIDR ranges your own reverse proxy connects from, comma-separated. better-auth
# walks the X-Forwarded-For chain right to left and takes the first address that
# is NOT in these ranges; everything before it is client-controlled and dropped.
# Without this it cannot resolve a client IP at all: the sign-in rate limit
# degrades to one bucket shared by everyone, and the device list in
# /settings/account shows no address. Docker bridge is usually 172.16.0.0/12.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Recipe suggestions (optional). With a key, "Rezepte" takes a slot in the
# bottom bar ("Mehr" moves to the top of the home screen, next to the list
# switcher) and a button turns the stock into three dishes on demand. Without
# a key the bar stays as it was and POST /api/recipes/generate answers 503 --
# the whole feature is off. Get a key at
# https://aistudio.google.com/apikey; the free tier is enough for a household.
# Note what leaves the house: name, category, quantity and expiry date of the
# soon-expiring items, plus name, category and quantity (no dates) of up to
# ten further items, so the dishes are more than leftovers in a pan, plus the
# titles of the last suggestions so a second run proposes something else.
# Expired items and drinks are never included. The button asks before it
# sends, and a list may generate at most 5 batches per hour and 20 per day --
# our own limits, not Google's: theirs are no longer published as a table,
# only visible in the AI Studio of your account. See src/lib/recipes.ts.
GEMINI_API_KEY=
# Which model answers, as a comma-separated chain tried left to right.
# Optional -- defaults to
#   gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# The fallbacks are not theoretical: Flash models regularly answer 503 "this
# model is currently experiencing high demand", and the next one in line
# usually answers straight away. Only overload moves to the next model -- an
# exhausted quota (429) stops right there instead of quietly spending the
# next model's.
# A single name here disables the chain and pins that one model.
GEMINI_MODEL=

# Generic OIDC SSO (optional). Leave all unset to disable the SSO button entirely.
# Issuer base URL -- the discovery document is expected at
# {OIDC_ISSUER}/.well-known/openid-configuration
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button label shown on /login and /register ("Mit ... anmelden"). Optional,
# defaults to "SSO". The button itself is gated on the three values above --
# it is read at runtime, so setting it on an existing container is enough.
OIDC_DISPLAY_NAME=

TZ=Europe/Berlin