# Copy to .env and fill in real values. Never commit .env.
# Required = the server refuses to start without it (production only).
# Optional = the feature it belongs to stays off while it is unset.

# --- Auth (required in production) -------------------------------------------

# Session signing key. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public base URL of this instance, as the browser reaches it.
BETTER_AUTH_URL=http://localhost:3000

# "false" closes sign-up; sign-in and SSO keep working. Read at runtime, so a
# restart is enough. Keep "true" for the very first start -- otherwise no
# account can ever be created.
ALLOW_REGISTRATION=true

# CIDRs your own reverse proxy connects from, comma-separated. better-auth
# walks X-Forwarded-For right to left and takes the first address outside these
# ranges; everything before it is client-controlled and dropped. Unset, no
# client IP can be resolved: the sign-in rate limit becomes one global bucket
# and /settings/account shows no addresses. Docker bridge: 172.16.0.0/12.
# Set it empty if the app is exposed directly, so no client header is trusted.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Web push (optional: all three or none, a partial set throws at startup) --

# Generate the keypair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI push services may use to reach you (mailto: or https:).
VAPID_SUBJECT=mailto:you@example.com

# --- Expiry reminders --------------------------------------------------------

# Built-in hourly scheduler. Set exactly "false" to run the job externally.
INTERNAL_CRON=true

# Bearer token for POST /api/cron/check-expiry. That route is public (external
# cron has no session cookie), so an unset secret closes it with 503 instead of
# opening it. The built-in scheduler runs either way. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Recipe suggestions (optional) -------------------------------------------

# Google Gemini key: https://aistudio.google.com/apikey -- the free tier covers
# a household. Unset, the feature is fully off: the bottom bar keeps "Mehr" and
# POST /api/recipes/generate answers 503.
# What leaves the house per request: name, category, quantity and expiry date of
# up to 8 soon-expiring items, the same without dates for up to 10 further ones,
# and the titles of the last suggestions so a rerun differs. Expired items and
# drinks are never sent, and the button asks first.
# Limits per list: 5 batches/hour and 20/day (both overridable by an explicit
# confirmation), plus a hard 50/day. Ours, not Google's -- theirs are only
# visible in your AI Studio. Details: src/lib/recipes/.
GEMINI_API_KEY=

# Model chain, comma-separated, tried left to right when one is overloaded (503)
# or out of quota (429) -- Flash models hit both regularly. One name pins it.
# Default: gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_MODEL=

# --- Mealie export (optional: both or neither) -------------------------------

# Send a generated recipe to a Mealie instance (https://mealie.io). Unset, the
# export button never renders and POST /api/recipes/export answers 503.
# The address as this server reaches Mealie, no trailing slash. A sub-path
# ("https://haus.example/mealie") is kept and prefixed to every API call.
MEALIE_URL=

# Long-lived API token: Mealie -> profile -> "API Tokens" -> create. Sent as
# "Authorization: Bearer ...", so every export lands in that token's account
# and group -- one household account, not one per Frischling user.
# Export writes: it creates a recipe (title, description, ingredients as plain
# notes, steps) and one note listing what came from the pantry and what still
# has to be bought. It never reads or changes anything already in Mealie.
MEALIE_TOKEN=

# --- OIDC SSO (optional: all unset = no SSO button) --------------------------

# Discovery is read from {OIDC_ISSUER}/.well-known/openid-configuration
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Button label on /login and /register ("Mit ... anmelden"). Default: "SSO".
OIDC_DISPLAY_NAME=

# --- Misc --------------------------------------------------------------------

# Extra hosts/IPs allowed to reach the Next.js dev server, comma-separated.
ALLOWED_DEV_ORIGINS=

# Server timezone -- expiry days and reminder times are computed in it.
TZ=Europe/Berlin
